# Use the mock model: no API key, no cost. CI sets it; production forbids it.
AI_MOCK=1

# "provider/model" string routed through the Vercel AI Gateway. Required unless AI_MOCK=1.
AI_MODEL=

# Local real-model runs only, such as a real `pnpm eval` (template spec §5.11). On Vercel the AI
# SDK uses OIDC automatically. Locally, instead of a key, `vercel env pull .env.local` writes a
# VERCEL_OIDC_TOKEN (git-ignored) that the AI SDK uses the same way; `pnpm eval` and `next dev`
# load it. It pulls Development's variables, so it brings no AI_MODEL: set that in the command.
# The token expires: pull it again for a later run.
AI_GATEWAY_API_KEY=

# Rate limiter. In the Vercel Marketplace pick "Upstash for Redis" (not "Redis", whose TCP
# REDIS_URL @upstash/redis does not use), with no custom prefix, connected to Production only.
# It injects KV_REST_API_URL, KV_REST_API_TOKEN, KV_REST_API_READ_ONLY_TOKEN, KV_URL and
# REDIS_URL; the limiter reads only the first two (or UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN). Empty = limiter off, which is what local runs want (template spec
# §5.3, §6).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Requests per hour per IP. Default 20.
RATE_LIMIT_PER_HOUR=20
